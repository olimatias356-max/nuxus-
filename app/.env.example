# Copiá este archivo como .env y completá con los datos de tu proyecto de Supabase
# (Dashboard → Project Settings → API). Son valores PÚBLICOS: la seguridad la da RLS.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# store = Google Play / App Store (producción). sandbox = compras de prueba sin cobro (solo desarrollo;
# requiere ALLOW_SANDBOX_PURCHASES=true en las Edge Functions).
EXPO_PUBLIC_BILLING_MODE=store
