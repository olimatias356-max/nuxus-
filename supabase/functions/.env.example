# Edge Functions secrets. Names only: set values with `supabase secrets set NAME=value`
# (or a local, git-ignored supabase/functions/.env). Never commit real values.

# Injected automatically on hosted Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# admob-import: OAuth client + refresh token with scope https://www.googleapis.com/auth/admob.readonly
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_REFRESH_TOKEN=
# pub-XXXXXXXXXXXXXXXX
ADMOB_PUBLISHER_ID=
# Units of each creator currency per 1 unit of the AdMob report currency, e.g. {"PYG":7300,"ARS":1150,"BRL":5.4}
FX_RATES_JSON=

# dlocal-payouts / payout-webhook?provider=dlocal
# https://sandbox.dlocal.com (sandbox) or https://api.dlocal.com (production)
DLOCAL_API_URL=
# Optional, defaults to /payouts/v3
DLOCAL_PAYOUTS_PATH=
DLOCAL_LOGIN=
DLOCAL_TRANS_KEY=
DLOCAL_SECRET_KEY=
# Optional, defaults to $SUPABASE_URL/functions/v1/payout-webhook?provider=dlocal
DLOCAL_NOTIFICATION_URL=

# payout-webhook generic HMAC mode (tests / other providers)
PAYOUT_WEBHOOK_SECRET=

# push-dispatch (optional, Expo enhanced push security)
EXPO_ACCESS_TOKEN=
